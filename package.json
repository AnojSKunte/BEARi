{
  "name": "beari",
  "productName": "BEARi",
  "version": "1.0.0",
  "description": "BEARi — a living desktop AI companion",
  "main": "out/main/index.js",
  "private": true,
  "author": "Anoj",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview:web": "vite --config vite.preview.config.ts",
    "icon": "tsx scripts/make-icon.ts",
    "frames": "tsx scripts/build-frames.ts",
    "preview:frames": "tsx scripts/preview-frames.ts",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win --publish never",
    "pack:portable": "npm run build && node scripts/pack-portable.mjs",
    "release": "node scripts/release.mjs",
    "test:brain": "tsx scripts/test-brain.ts",
    "setup:github": "node scripts/setup-github.mjs"
  },
  "devDependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.6",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "three": "^0.170.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.beari.companion",
    "productName": "BEARi",
    "copyright": "Copyright © 2026 Anoj",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BEARi"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "beari",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/after-pack.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USERNAME/beari.git"
  }
}
